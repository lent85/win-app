<Page x:Class="ProtonVPN.Client.UI.Main.Settings.Pages.About.AboutPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:custom="using:ProtonVPN.Client.Common.UI.Controls.Custom"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ProtonVPN.Client.UI.Settings.Pages.About.Models"
      xmlns:sys="using:System"
      xmlns:update="using:ProtonVPN.Client.UI.Update"
      x:DefaultBindMode="OneWay"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <custom:SettingsPageContentControl x:Name="PageContentHost"
                                       ApplyCommand="{x:Bind ViewModel.ApplyCommand}"
                                       BackCommand="{x:Bind ViewModel.NavigateBackCommand, Mode=OneTime}"
                                       CanContentScroll="True"
                                       CloseCommand="{x:Bind ViewModel.CloseCommand, Mode=OneTime}"
                                       IsBackButtonVisible="{x:Bind ViewModel.CanGoBack}">

        <custom:SettingsPageContentControl.PageHeader>
            <custom:SettingsPageHeaderContentControl Header="{x:Bind ViewModel.Title}"
                                                     Style="{StaticResource SettingsPageHeaderContentControlStyle}" />
        </custom:SettingsPageContentControl.PageHeader>

        <custom:SettingsPageContentControl.StickyContent>

            <StackPanel Grid.Row="0"
                        Spacing="16">

                <Grid ColumnSpacing="16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="72"
                            Height="72"
                            Padding="8">
                        <Image Source="{StaticResource ProtonVpnOnApplicationIconSource}"
                               Stretch="Uniform" />
                    </Border>

                    <Grid Grid.Column="1"
                          Margin="0,4"
                          RowSpacing="6">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Localizer.Get('Settings_About_CurrentVersion')}" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="0,0,8,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="CurrentVersionLabel"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Text="{x:Bind ViewModel.ClientVersion}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="Custom dev version" />
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                            <Border Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource InteractionDefaultColorBrush}"
                                    CornerRadius="4">
                                <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="Custom" />
                            </Border>
                            <TextBlock VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="CustomDevVersionLabel"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.CustomVersion}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="Installed build" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,0,8,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="InstalledBuildLabel"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="{x:Bind ViewModel.InstalledBuildSummary}" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Localizer.Get('Settings_About_Licensing')}" />
                        <custom:GhostButton Grid.Row="3"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.NavigateToLicensingPageCommand, Mode=OneTime}"
                                            Content="{x:Bind ViewModel.Localizer.Get('Settings_About_LearnMore')}"
                                            Style="{StaticResource PrimaryGhostButtonStyle}" />
                    </Grid>
                </Grid>

                <Border Padding="8,12,16,12"
                        Background="{ThemeResource InteractionDefaultColorBrush}"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <update:UpdateComponent Title="{x:Bind ViewModel.Localizer.Get('Components_Update_UpdateAvailable')}"
                                            Description="{x:Bind ViewModel.Localizer.Get('Components_Update_GetMostFromYourVpn')}"
                                            IsImageVisible="False" />
                </Border>

                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}"
                           Text="{x:Bind ViewModel.Localizer.Get('Settings_About_Changelog')}" />

                <SelectorBar>
                    <SelectorBarItem IsSelected="{x:Bind ViewModel.IsCustomChangelogTabSelected, Mode=TwoWay}"
                                     Text="{x:Bind ViewModel.CustomChangelogTabHeader}" />
                    <SelectorBarItem IsSelected="{x:Bind ViewModel.IsUpstreamChangelogTabSelected, Mode=TwoWay}"
                                     Text="{x:Bind ViewModel.UpstreamChangelogTabHeader}" />
                </SelectorBar>
            </StackPanel>
        </custom:SettingsPageContentControl.StickyContent>

        <StackPanel Spacing="12">
            <!-- Custom (Origin) Tab -->
            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsCustomChangelogTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Padding="12"
                        Background="{ThemeResource BackgroundWeakColorBrush}"
                        BorderBrush="{ThemeResource BorderWeakColorBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Text="{x:Bind ViewModel.BuildBranchAndCommit}" />
                        <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Text="{x:Bind ViewModel.UpstreamBaseSummary}" />
                        <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Text="{x:Bind ViewModel.BuiltAtDisplay}"
                                   Visibility="{x:Bind ViewModel.HasBuiltAtDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Foreground="{ThemeResource SignalWarningColorBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Text="{x:Bind ViewModel.ServiceMismatchMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasServiceVersionMismatch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.CustomReleases}"
                               Visibility="{x:Bind ViewModel.HasCustomReleases, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:CustomReleaseGroup">
                            <StackPanel Margin="0,4,0,12"
                                        Spacing="4">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Text="{x:Bind DateLabel, Mode=OneTime}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextWeakColorBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind CommitCountLabel, Mode=OneTime}" />
                                </StackPanel>

                                <ItemsControl Margin="4,0,0,0"
                                              ItemsSource="{x:Bind Changes, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomChangeItem">
                                            <TextBlock Margin="0,1,0,1"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       TextWrapping="Wrap">
                                                <Run Text="• " />
                                                <Run Foreground="{ThemeResource TextWeakColorBrush}"
                                                     Text="{x:Bind CommitAndCategoryLabel, Mode=OneTime}" />
                                                <Run Text=" " />
                                                <Run Text="{x:Bind Subject, Mode=OneTime}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Text="No custom changelog entries bundled with this build."
                           Visibility="{x:Bind ViewModel.HasNoCustomReleases, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- Upstream (Proton) Tab -->
            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsUpstreamChangelogTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,6,0,0"
                      VerticalAlignment="Center"
                      ColumnSpacing="8"
                      Visibility="{x:Bind ViewModel.IsToShowLoadingComponent, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ProgressRing Grid.Column="0"
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsToShowLoadingComponent}" />
                    <TextBlock Grid.Column="1"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Settings_About_Loading')}" />
                </Grid>

                <Grid HorizontalAlignment="Left"
                      ColumnSpacing="16"
                      Visibility="{x:Bind ViewModel.IsToShowErrorComponent, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Margin="0,6,0,0"
                               VerticalAlignment="Top"
                               Foreground="{ThemeResource TextWeakColorBrush}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Text="{x:Bind ViewModel.Localizer.Get('Settings_About_FailedToFetch')}" />
                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.TryAgainCommand, Mode=OneTime}"
                            Content="{x:Bind ViewModel.Localizer.Get('Common_Actions_TryAgain')}"
                            Style="{ThemeResource PrimaryButtonStyle}" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Releases}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Release">
                            <StackPanel Margin="0,8,0,16"
                                        Spacing="4">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Text="{x:Bind Version, Mode=OneTime}" />
                                    <custom:TagControl VerticalAlignment="Center"
                                                       Style="{StaticResource BetaTagControlStyle}"
                                                       Text="{x:Bind BetaVersionLabel, Mode=OneTime}"
                                                       Visibility="{x:Bind BetaVersionLabel, Converter={StaticResource StringVisibilityConverter}, Mode=OneTime}" />
                                    <custom:TagControl VerticalAlignment="Center"
                                                       Style="{StaticResource NewTagControlStyle}"
                                                       Text="{x:Bind NewVersionLabel, Mode=OneTime}"
                                                       Visibility="{x:Bind NewVersionLabel, Converter={StaticResource StringVisibilityConverter}, Mode=OneTime}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextWeakColorBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Text="{x:Bind sys:String.Format('{0:d}', ReleaseDate), Mode=OneTime}"
                                               Visibility="{x:Bind ReleaseDate, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                </StackPanel>

                                <ItemsControl Margin="4,0,0,0"
                                              ItemsSource="{x:Bind ChangeLog, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                                <Run Text="• " />
                                                <Run Text="{x:Bind}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </custom:SettingsPageContentControl>
</Page>