<Page x:Class="ProtonVPN.Client.UI.Main.Settings.Pages.Connection.MultiTunnelPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:custom="using:ProtonVPN.Client.Common.UI.Controls.Custom"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:ProtonVPN.Client.UI.Main.Settings.Pages.Connection"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      x:DefaultBindMode="OneWay"
      AutomationProperties.AutomationId="MultiTunnelPage"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <Page.Resources>
        <Thickness x:Key="PageContentControlPadding">16</Thickness>
    </Page.Resources>

    <custom:SettingsPageContentControl x:Name="PageContentHost"
                                       ApplyCommand="{x:Bind ViewModel.ApplyCommand, Mode=OneTime}"
                                       ApplyCommandText="{x:Bind ViewModel.ApplyCommandText}"
                                       BackCommand="{x:Bind ViewModel.NavigateBackCommand, Mode=OneTime}"
                                       CloseCommand="{x:Bind ViewModel.CloseCommand, Mode=OneTime}"
                                       IsBackButtonVisible="{x:Bind ViewModel.CanGoBack}">

        <custom:SettingsPageContentControl.PageHeader>
            <custom:SettingsPageHeaderContentControl Header="{x:Bind ViewModel.Title}" />
        </custom:SettingsPageContentControl.PageHeader>

        <StackPanel x:Name="ContentArea"
                    Spacing="20">

            <!-- 1. Master Toggle & Default Unmatched Routing -->
            <controls:SettingsExpander Description="{x:Bind ViewModel.SummaryText}"
                                       Header="Multi-Tunnel &amp; Priority Selective Routing"
                                       IsExpanded="True"
                                       IsTabStop="False">
                <ToggleSwitch AutomationProperties.AutomationId="MultiTunnelEnableSwitch"
                              IsOn="{x:Bind ViewModel.IsMultiTunnelEnabled, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchStyle}" />
                <controls:SettingsExpander.Items>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Text="Default policy when no priority rule matches:" />
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.TargetTypeOptions, Mode=OneTime}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDefaultTargetType, Mode=TwoWay}"
                                  Style="{StaticResource ComboBoxStyle}" />
                        <ComboBox Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.SlotIdOptions, Mode=OneTime}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDefaultTunnelId, Mode=TwoWay}"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Visibility="{x:Bind ViewModel.IsDefaultTargetTunnel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- 2. Tunnel Slots (T1..T5) + Country/Server Picker -->
            <Border Padding="16"
                    Background="{ThemeResource BackgroundWeakColorBrush}"
                    BorderBrush="{ThemeResource BorderWeakColorBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="Tunnel Slots (T1 - T5) &amp; Country / Server Picker" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  Header="Target Slot"
                                  ItemsSource="{x:Bind ViewModel.SlotPickerTargets}"
                                  SelectedItem="{x:Bind ViewModel.SelectedEditSlotId, Mode=TwoWay}"
                                  Style="{StaticResource ComboBoxStyle}" />

                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  Header="Country / Exit"
                                  ItemsSource="{x:Bind ViewModel.AvailableCountries}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPickerCountry, Mode=TwoWay}"
                                  Style="{StaticResource ComboBoxStyle}" />

                        <ComboBox Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  Header="Server"
                                  ItemsSource="{x:Bind ViewModel.AvailableServers}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPickerServer, Mode=TwoWay}"
                                  Style="{StaticResource ComboBoxStyle}" />

                        <Button Grid.Column="3"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.AddOrUpdateSlotCommand, Mode=OneTime}"
                                Content="Apply / + Slot"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind ViewModel.SlotPickerStatus}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:MultiTunnelSlotItem">
                                <Border Margin="0,4,0,0"
                                        Padding="12,8"
                                        Background="{ThemeResource InteractionDefaultColorBrush}"
                                        BorderBrush="{ThemeResource BorderWeakColorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Text="{x:Bind SlotId}" />

                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Text="{x:Bind SlotSummary}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind StatusText}" />

                                        <Border Grid.Column="3"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource BackgroundWeakColorBrush}"
                                                CornerRadius="4">
                                            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Text="{x:Bind RuleCountBadge}" />
                                        </Border>

                                        <Button Grid.Column="4"
                                                Click="OnAssignTemplatesToSlotClick"
                                                Content="+ Templates"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Tag="{x:Bind SlotId}" />

                                        <Button Grid.Column="5"
                                                Click="OnConnectSlotClick"
                                                Content="{x:Bind ConnectButtonText}"
                                                IsEnabled="{x:Bind CanToggleConnection}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Tag="{x:Bind SlotId}" />

                                        <Button Grid.Column="6"
                                                Click="OnRemoveSlotClick"
                                                Content="Remove"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Tag="{x:Bind SlotId}"
                                                Visibility="{x:Bind CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Rule Conflict Warnings (if any) -->
            <Border Padding="12"
                    Background="{ThemeResource BackgroundWeakColorBrush}"
                    BorderBrush="{ThemeResource SignalWarningColorBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasConflicts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="{ThemeResource SignalWarningColorBrush}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="Rule Ordering Conflicts Detected" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ConflictMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3.5 Routing Service Templates / Presets (Tunnel-First Assignment) -->
            <Border x:Name="PresetSectionBorder"
                    Padding="16"
                    Background="{ThemeResource BackgroundWeakColorBrush}"
                    BorderBrush="{ThemeResource BorderWeakColorBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="Assign Service Templates to a Tunnel" />
                            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="Step 1: Pick the target tunnel (T1-T5, Direct, Block). Step 2: Click + on a template, or check several to assign together." />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind ViewModel.SelectedPresetCountText}" />

                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.SelectAllVisiblePresetsCommand, Mode=OneTime}"
                                Content="Select All"
                                Style="{StaticResource SecondaryButtonStyle}" />

                        <Button Grid.Column="3"
                                Command="{x:Bind ViewModel.ClearSelectedPresetsCommand, Mode=OneTime}"
                                Content="Clear"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <!-- Step 1: Target Tunnel / Route Chip Selector Bar -->
                    <Border Padding="10,8"
                            Background="{ThemeResource InteractionDefaultColorBrush}"
                            BorderBrush="{ThemeResource BorderWeakColorBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="1. Assign to:" />

                                <ScrollViewer Grid.Column="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.PresetTargetOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:PresetTargetOption">
                                                <Button Padding="10,5"
                                                        Background="{x:Bind ChipBackgroundBrush}"
                                                        BorderBrush="{x:Bind ChipBorderBrush}"
                                                        BorderThickness="1.5"
                                                        Click="OnSelectPresetTargetClick"
                                                        CornerRadius="16"
                                                        Tag="{x:Bind Key}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6">
                                                        <Ellipse Width="8"
                                                                 Height="8"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{x:Bind DotBrush}" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Text="{x:Bind DisplayLabel}" />
                                                        <Border Padding="5,0"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource BackgroundWeakColorBrush}"
                                                                CornerRadius="8"
                                                                Visibility="{x:Bind HasRuleCount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       Text="{x:Bind RuleCountText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsPresetFallbackAllowed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextWeakColorBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="When tunnel drops:" />
                                <ComboBox Width="170"
                                          ItemsSource="{x:Bind ViewModel.PresetFallbackOptions, Mode=OneTime}"
                                          SelectedItem="{x:Bind ViewModel.SelectedPresetFallbackBehavior, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" />
                                <ComboBox Width="92"
                                          ItemsSource="{x:Bind ViewModel.SlotIdOptions, Mode=OneTime}"
                                          SelectedItem="{x:Bind ViewModel.SelectedPresetFallbackTunnelId, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Visibility="{x:Bind ViewModel.IsPresetFallbackTunnel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Filter & Pick Templates -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 PlaceholderText="2. Search templates (e.g., google, facebook, openai, lan)..."
                                 Text="{x:Bind ViewModel.PresetSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.PresetCategoryOptions, Mode=OneTime}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPresetCategory, Mode=TwoWay}"
                                  Style="{StaticResource ComboBoxStyle}" />
                    </Grid>

                    <ScrollViewer MaxHeight="260"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MultiTunnelPresetItem">
                                    <Border Margin="0,3,0,0"
                                            Padding="10,7"
                                            Background="{ThemeResource InteractionDefaultColorBrush}"
                                            BorderBrush="{ThemeResource BorderWeakColorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      MinWidth="24"
                                                      VerticalAlignment="Center"
                                                      Click="OnPresetCheckClick"
                                                      IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                      Style="{StaticResource CheckBoxStyle}"
                                                      Tag="{x:Bind Id}" />

                                            <StackPanel Grid.Column="1"
                                                        Spacing="2">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               Text="{x:Bind Name}" />
                                                    <Border Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource BackgroundWeakColorBrush}"
                                                            CornerRadius="4">
                                                        <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Text="{x:Bind Category}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Text="{x:Bind ConditionPreview}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                <Border Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource BackgroundWeakColorBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind IsCurrentlyAssigned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="5">
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{x:Bind CurrentRouteBrush}" />
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Text="{x:Bind CurrentRouteLabel}" />
                                                    </StackPanel>
                                                </Border>

                                                <Button Padding="10,4"
                                                        Click="OnQuickAssignPresetClick"
                                                        Content="{x:Bind QuickActionText}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Tag="{x:Bind Id}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Step 3: Batch Action Bar -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Command="{x:Bind ViewModel.AddSelectedPresetsCommand, Mode=OneTime}"
                                Content="{x:Bind ViewModel.AssignSelectedButtonText}"
                                IsEnabled="{x:Bind ViewModel.HasSelectedPresets}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Command="{x:Bind ViewModel.ReplaceTargetWithSelectedPresetsCommand, Mode=OneTime}"
                                Content="{x:Bind ViewModel.ReplaceTargetButtonText}"
                                IsEnabled="{x:Bind ViewModel.HasSelectedPresets}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsSpecificPresetTargetSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Command="{x:Bind ViewModel.ReplaceWithSelectedPresetsCommand, Mode=OneTime}"
                                Content="Replace All"
                                IsEnabled="{x:Bind ViewModel.HasSelectedPresets}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Command="{x:Bind ViewModel.FillEditorFromSelectedPresetCommand, Mode=OneTime}"
                                Content="Load into Editor"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind ViewModel.PresetStatusText}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.HasPresetStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 4. Compact 2-Line Priority Rules Table -->
            <Border Padding="16"
                    Background="{ThemeResource BackgroundWeakColorBrush}"
                    BorderBrush="{ThemeResource BorderWeakColorBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="Priority Selective Routing Rules (Top-Down First Match Wins)" />
                            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="Top 13 rules get distinct native WFP weights (14 down to 2); rules #13+ share weight 2." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.ResetDefaultRulesCommand, Mode=OneTime}"
                                Content="Reset Defaults"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:MultiTunnelRuleItem">
                                <Border Margin="0,4,0,0"
                                        Padding="10,8"
                                        Background="{ThemeResource InteractionDefaultColorBrush}"
                                        BorderBrush="{ThemeResource BorderWeakColorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid ColumnSpacing="8"
                                          RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Row 0: Enabled, #Priority, Name, Target + Fallback, Actions -->
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  MinWidth="24"
                                                  Click="OnRuleEnabledClick"
                                                  IsChecked="{x:Bind IsEnabled}"
                                                  Style="{StaticResource CheckBoxStyle}"
                                                  Tag="{x:Bind Id}" />

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Text="{x:Bind PriorityBadge}" />

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Text="{x:Bind Name}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Border Grid.Row="0"
                                                Grid.Column="3"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource BackgroundWeakColorBrush}"
                                                CornerRadius="4">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Text="{x:Bind TargetBadge}" />
                                        </Border>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="4"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind FallbackBadge}" />

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Click="OnMoveRuleUpClick"
                                                    Content="Up"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Tag="{x:Bind Id}" />
                                            <Button Click="OnMoveRuleDownClick"
                                                    Content="Down"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Tag="{x:Bind Id}" />
                                            <Button Click="OnEditRuleClick"
                                                    Content="Edit"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Tag="{x:Bind Id}" />
                                            <Button Click="OnDeleteRuleClick"
                                                    Content="Del"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Tag="{x:Bind Id}" />
                                        </StackPanel>

                                        <!-- Row 1: Match Criteria -->
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   Grid.ColumnSpan="4"
                                                   Foreground="{ThemeResource TextWeakColorBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind CriteriaSummary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inline Rule Editor -->
                    <Border Margin="0,8,0,0"
                            Padding="12"
                            BorderBrush="{ThemeResource BorderNormColorBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.RuleEditorTitle}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Header="Rule Name"
                                         PlaceholderText="e.g., AI &amp; Work Tools"
                                         Text="{x:Bind ViewModel.RuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1"
                                         Header="Applications (comma-separated)"
                                         PlaceholderText="opera, chrome, or C:\Path\app.exe"
                                         Text="{x:Bind ViewModel.RuleAppPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.ToggleAppPickerCommand, Mode=OneTime}"
                                        Content="Pick App / Process"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="3"
                                        VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.BrowseAppExecutableCommand, Mode=OneTime}"
                                        Content="Browse .exe"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <!-- Running Processes & Installed Apps Picker -->
                            <Border Padding="10"
                                    Background="{ThemeResource InteractionDefaultColorBrush}"
                                    BorderBrush="{ThemeResource BorderWeakColorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{x:Bind ViewModel.IsAppPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 PlaceholderText="Filter running processes or installed apps (e.g., opera, chrome)..."
                                                 Text="{x:Bind ViewModel.AppPickerSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1"
                                                Command="{x:Bind ViewModel.RefreshDiscoveredAppsCommand, Mode=OneTime}"
                                                Content="Refresh"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Grid.Column="2"
                                                Command="{x:Bind ViewModel.ToggleAppPickerCommand, Mode=OneTime}"
                                                Content="Close"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                    <ScrollViewer MaxHeight="200"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredDiscoveredApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:DiscoveredAppItem">
                                                    <Border Margin="0,2,0,0"
                                                            Padding="8,5"
                                                            Background="{ThemeResource BackgroundWeakColorBrush}"
                                                            BorderBrush="{ThemeResource BorderWeakColorBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0"
                                                                        Spacing="1">
                                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                           Text="{x:Bind DisplayName}" />
                                                                <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Text="{x:Bind Subtitle}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1"
                                                                    Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource InteractionDefaultColorBrush}"
                                                                    CornerRadius="4">
                                                                <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Text="{x:Bind BadgeText}" />
                                                            </Border>
                                                            <Button Grid.Column="2"
                                                                    Padding="8,3"
                                                                    Click="OnPickDiscoveredAppClick"
                                                                    Content="+ Add"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Tag="{x:Bind ExecutablePath}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Header="Domains (wildcards supported)"
                                         PlaceholderText="*.openai.com, *.vn"
                                         Text="{x:Bind ViewModel.RuleDomainPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1"
                                         Header="IP / CIDR"
                                         PlaceholderText="192.168.0.0/16, 10.100.0.0/16"
                                         Text="{x:Bind ViewModel.RuleIpCidrPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Header="Ports"
                                         PlaceholderText="443, 3478-3481"
                                         Text="{x:Bind ViewModel.RulePortPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          Header="Protocol"
                                          ItemsSource="{x:Bind ViewModel.ProtocolOptions, Mode=OneTime}"
                                          SelectedItem="{x:Bind ViewModel.RuleProtocol, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" />
                                <ComboBox Grid.Column="2"
                                          HorizontalAlignment="Stretch"
                                          Header="Route To"
                                          ItemsSource="{x:Bind ViewModel.TargetTypeOptions, Mode=OneTime}"
                                          SelectedItem="{x:Bind ViewModel.RuleTargetType, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}" />
                                <ComboBox Grid.Column="3"
                                          HorizontalAlignment="Stretch"
                                          Header="Tunnel"
                                          ItemsSource="{x:Bind ViewModel.SlotIdOptions, Mode=OneTime}"
                                          SelectedItem="{x:Bind ViewModel.RuleTargetTunnelId, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Visibility="{x:Bind ViewModel.IsRuleTargetTunnel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ComboBox Grid.Column="4"
                                          HorizontalAlignment="Stretch"
                                          Header="When Disconnected"
                                          ItemsSource="{x:Bind ViewModel.FallbackOptions, Mode=OneTime}"
                                          SelectedItem="{x:Bind ViewModel.RuleFallbackBehavior, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Visibility="{x:Bind ViewModel.IsRuleTargetTunnel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <ComboBox Width="150"
                                          Header="Fallback Tunnel"
                                          ItemsSource="{x:Bind ViewModel.SlotIdOptions, Mode=OneTime}"
                                          SelectedItem="{x:Bind ViewModel.RuleFallbackTunnelId, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Visibility="{x:Bind ViewModel.IsRuleFallbackTunnel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.SaveRuleCommand, Mode=OneTime}"
                                        Content="Save Rule"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button VerticalAlignment="Bottom"
                                        Command="{x:Bind ViewModel.CancelEditRuleCommand, Mode=OneTime}"
                                        Content="Clear / Cancel"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Traffic Routing Simulator -->
            <Border Padding="16"
                    Background="{ThemeResource BackgroundWeakColorBrush}"
                    BorderBrush="{ThemeResource BorderWeakColorBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="Traffic Routing Simulator (Verify WFP Precedence)" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Header="App / Process"
                                 Text="{x:Bind ViewModel.SimApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1"
                                 Header="Domain"
                                 Text="{x:Bind ViewModel.SimDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="2"
                                 Header="Remote IP"
                                 Text="{x:Bind ViewModel.SimRemoteIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="3"
                                 Header="Port"
                                 Text="{x:Bind ViewModel.SimPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="4"
                                  HorizontalAlignment="Stretch"
                                  Header="Protocol"
                                  ItemsSource="{x:Bind ViewModel.ProtocolOptions, Mode=OneTime}"
                                  SelectedItem="{x:Bind ViewModel.SimProtocol, Mode=TwoWay}"
                                  Style="{StaticResource ComboBoxStyle}" />
                        <Button Grid.Column="5"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.RunSimulationCommand, Mode=OneTime}"
                                Content="Simulate"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <Border Padding="10,8"
                            Background="{ThemeResource InteractionDefaultColorBrush}"
                            CornerRadius="6"
                            Visibility="{x:Bind ViewModel.HasSimResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.SimResultSummary}" />
                            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.SimResultDetails}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </custom:SettingsPageContentControl>

</Page>
